# Exemplo de variáveis de ambiente. NÃO colocar valores reais aqui.
# Copiar para .env.local (ignorado pelo git) e preencher, ou definir na Vercel.

# ── Supabase (já em uso) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Crons (GitHub Actions) ────────────────────────────────────────────────────
CRON_SECRET=

# ── Marketing e Publicações ───────────────────────────────────────────────────
# A Fase 1 (organização e aprovação) NÃO precisa de variáveis novas.
# As seguintes são só para a Fase 2/3 (publicação automática nas redes) e devem
# ficar por preencher / desligadas até haver autorização explícita.
#
# Feature flag global da publicação automática (manter false até validação):
# MARKETING_PUBLISH_ENABLED=false
#
# Meta (Facebook / Instagram) — App do Meta for Developers:
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v21.0
#
# LinkedIn — LinkedIn Developers (Community Management):
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
#
# Canva — integração oficial (opcional, futura):
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
